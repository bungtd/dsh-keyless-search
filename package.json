{
  "name": "dsh-keyless-search",
  "version": "2.0.0",
  "description": "Keyless web search for DeepSeek Harness: a chain of public search backends (WebCrawler, Mwmbl, Exa, Parallel, Wikipedia, Hacker News, MDN, npm, arXiv, Google News) that need no API key. Works on Windows, macOS, and Linux.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.id.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:live": "DSH_KEYLESS_LIVE=1 node --test \"test/live.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-search",
    "websearch",
    "keyless",
    "no-api-key",
    "webcrawler",
    "mwmbl",
    "exa",
    "parallel",
    "wikipedia",
    "hacker-news",
    "mcp",
    "agent",
    "coding-assistant"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
